generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Tenant {
  id          String         @id @default(uuid())
  slug        String         @unique // "angular-v4", "next-v1", "vue-v3", "nuxt-v2", "default"
  name        String
  domain      String?        @unique // Custom domain support (e.g., app.customdomain.com)
  description String?
  status      TenantStatus   @default(ACTIVE)
  isActive    Boolean        @default(true)
  settings    Json?          // Tenant-specific branding, theme, configuration
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  users       User[]
  memberships TenantMembership[]
  quizQuestions QuizQuestion[]
  quizProgress QuizProgress[]

  @@map("tenants")
}

model TenantMembership {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole @default(MEMBER)
  status    String     @default("ACTIVE")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model User {
  id                  String             @id @default(uuid())
  tenantId            String?
  email               String             @unique
  password            String?            // Optional for social-only users
  name                String?
  username            String             @unique
  role                UserRole           @default(USER)
  isActive            Boolean            @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  avatarId            String?
  isDeleted           Boolean            @default(false)
  isEmailVerified     Boolean            @default(true)
  onboardingCompleted Boolean            @default(false)
  
  tenant              Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  avatar              File?              @relation("UserAvatar", fields: [avatarId], references: [id])
  sessions            Session[]
  memberships         TenantMembership[]
  quizProgress        QuizProgress[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id                String    @id @default(uuid())
  userId            String
  refreshToken      String?   @unique
  provider          String    @default("local") // "local" | "google" | "github" | "apple"
  providerUserId    String?   // OAuth user ID for social logins
  accessToken       String?   // OAuth access token
  scopes            String?
  avatarUrl         String?
  ipAddress         String?   // Origin IP for session tracking
  userAgent         String?   // Client device / browser agent
  lastUsedAt        DateTime?
  revokedAt         DateTime? // Soft-revocation
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider, providerUserId])
  @@map("sessions")
}

model File {
  id        String    @id @default(uuid())
  filename  String?
  fileUrl   String?
  mimeType  String?   // e.g. "image/png", "application/pdf"
  fileSize  Int?      // Size in bytes
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  metaData  Json?
  users     User[]    @relation("UserAvatar")

  @@map("files")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
  DEVELOPER
}

model QuizQuestion {
  id           Int      @id
  tenantId     String?
  category     String
  difficulty   String   @default("INTERMEDIATE") // BEGINNER | INTERMEDIATE | ADVANCED | EXPERT
  question     String   @db.Text
  codeSnippet  String?  @db.Text
  options      String[]
  correctIndex Int
  explanation  String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([category])
  @@index([difficulty])
  @@map("quiz_questions")
}

model QuizProgress {
  id            String   @id @default(uuid())
  tenantId      String?
  userId        String?
  sessionId     String   @default("default-session")
  answers       Json     @default("{}")
  score         Int      @default(0)
  answeredCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, sessionId])
  @@index([tenantId])
  @@index([userId])
  @@map("quiz_progress")
}
