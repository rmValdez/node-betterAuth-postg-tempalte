# Server & Environment
PORT=4009
NODE_ENV=development
LOG_LEVEL=debug

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/node_betterauth_template_db?schema=public"

# Better Auth
# BETTER_AUTH_SECRET is required — the app refuses to start without it (no
# insecure default). Generate one, e.g.: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:4009
# Production frontend origin (also trusted by Better Auth); add more via CORS_ORIGIN
# FRONTEND_URL=https://app.yourdomain.com

# CORS Allowlist (comma-separated origins)
CORS_ORIGIN=http://localhost:4010

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# AWS S3 / Cloudflare R2 Cloud Storage (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=your-bucket-name
S3_CDN_URL=https://cdn.yourdomain.com

# Nodemailer / SMTP Email Service (Optional)
MAILER_EMAIL=your-email@example.com
MAILER_PASSWORD=your-app-password
MAILER_FROM_NAME="RM Enterprise"
MAILER_TRANSPORT_HOST=smtp.gmail.com
MAILER_TRANSPORT_PORT=587
MAILER_TRANSPORT_SECURE=false
