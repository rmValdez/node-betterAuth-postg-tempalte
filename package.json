{
  "name": "node-postg-backend-template",
  "version": "1.0.0",
  "description": "Production-ready Node.js/TypeScript boilerplate with Prisma and Express",
  "main": "dist/src/server.js",
  "packageManager": "pnpm@9.15.9",
  "license": "MIT",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx ./src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc",
    "start": "node ./dist/src/server.js",
    "lint": "eslint . --fix",
    "validate": "node tools/validate-architecture.mjs",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage",
    "db:setup": "npx prisma generate && npx prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@sentry/node": "^10.73.0",
    "amqplib": "^2.0.1",
    "axios": "^1.6.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "handlebars": "^4.7.9",
    "helmet": "^7.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.0",
    "prisma": "^6.19.2",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.18",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.4",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.8.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.5.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.0.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
